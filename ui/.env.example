# Copy to .env for a build, or .env.development.local for `npm run dev`.

# The API as the browser reaches it: through opengate, which validates the
# OpenAuth session and injects the operator's identity and permissions.
VITE_API_BASE_URL=https://api.bappaapp.com
VITE_LOGIN_URL=https://auth.bappaapp.com/login

# ---- Local development without opengate/OpenAuth (npm run dev only) ----
# Leave VITE_API_BASE_URL empty so calls go to the dev server, which proxies
# them to a local OpenPay. The console sends the operator headers itself, in
# opengate's place; a production build never sends them.
# DEV_OPENPAY_URL=http://localhost:8085
# VITE_DEV_USER_ID=dev-operator
# VITE_DEV_USER_PERMS=openpay:scope:all,openpay:products:read,openpay:ledger:read
# VITE_DEV_SKIP_LOGIN=true
